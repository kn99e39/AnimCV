FROM animcv-train:cuda118

ENV PIP_NO_CACHE_DIR=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

WORKDIR /workspace/AnimCV

# LabServer63's base image is CUDA 11.8 / PyTorch 2.1.x / Python 3.10.
# Install the matching prebuilt MMCV wheel rather than compiling CUDA
# extensions in the evaluation job. The bounds preserve the MMPose 1.x and
# MMDetection 3.x APIs used by pose/mmpose_adapter.py.
RUN python3 -m pip install --upgrade pip openmim && \
    python3 -m mim install "mmcv==2.1.0" && \
    python3 -m pip install \
        "mmdet==3.3.0" \
        "mmpose==1.3.2" \
        "numpy<2" \
        "opencv-python<4.10"

# Source is normally mounted read-only for evaluation. Keep a copy here so
# the image can also be smoke-tested without that mount.
COPY pyproject.toml ./
COPY src ./src
RUN python3 -m pip install -e '.[pose]'

ENTRYPOINT ["python3"]
CMD ["-m", "app.cli", "--help"]
